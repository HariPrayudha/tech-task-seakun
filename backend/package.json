{
  "name": "seakun-inventory-backend",
  "private": true,
  "version": "0.1.0",
  "description": "Product Inventory Management API",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run db:generate && tsc",
    "start": "node dist/server.js",
    "typecheck": "npm run db:generate && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/multer": "^2.2.0",
    "@types/node": "latest",
    "@types/supertest": "^7.2.1",
    "file-type": "^22.1.0",
    "multer": "^2.3.0",
    "prisma": "7.10.0",
    "supertest": "^7.2.2",
    "tsx": "latest",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
